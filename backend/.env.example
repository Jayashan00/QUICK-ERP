# Copy to .env (used by docker compose) or export these variables before running the backend.
# For a live system set APP_ENVIRONMENT=production: the server then refuses to start while any
# setting below is unsafe, and lists what to fix.

APP_ENVIRONMENT=development

# Database
DB_NAME=quickerp
DB_USERNAME=quickerp
DB_PASSWORD=change-this-database-password

# Session tokens: at least 32 random characters, for example the output of: openssl rand -base64 48
JWT_SECRET=
JWT_TTL_HOURS=24

# Your frontend address(es), comma-separated. Use https:// in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# Starter data on an empty database.
SEED_ENABLED=true
# true = full demo data; false = configuration only (roles, branches, settings, chart of accounts). Production: false.
SEED_DEMO_DATA=true
# Password of the starter accounts (admin@quickerp.test, ...). Production: a strong password, changed after first sign-in.
SEED_DEFAULT_PASSWORD=QuickERP123!

# Password given to users created in Settings > Users. Production: leave EMPTY, so new users use "Forgot password"
# (or an administrator sets their password) instead of everyone sharing one known password.
NEW_USER_INITIAL_PASSWORD=ChangeMe123!

# Password reset emails
PASSWORD_RESET_URL=http://localhost:5173/reset-password
MAIL_FROM=no-reply@quickerp.local
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# Address the backend port is published on. Keep 127.0.0.1 and put a reverse proxy (nginx, Caddy) with HTTPS in front.
BACKEND_BIND=127.0.0.1
# "native" trusts X-Forwarded-For only from private-network proxies, so rate limits apply per visitor.
FORWARD_HEADERS_STRATEGY=native
